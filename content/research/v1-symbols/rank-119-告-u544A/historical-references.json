  "etymologyNotes": [
    {
      "s": "makemeahanzi",
      "t": "To speak 口 with the force of an ox 牛"
    },
    {
      "s": "dong_chinese",
      "t": "Pictograph of a tongue extending from an open mouth. Graphically similar to 舌 (tongue)."
    },
    {
      "s": "shuowen_jiezi",
      "t": "牛觸人，角箸橫木，所以告人也。从口从牛。《易》曰：“僮牛之告。”凡告之屬皆从告。",
      "w": 1
    },
    {
      "s": "wiktionary",
      "t": "Cognate with Thai กล่าว (glàao, “to say; to declare”) (Schuessler, 2007)."
    },
    {
      "s": "wiktionary",
      "t": "From 校 (MC kaewH, “to check; to compare”) (Yang, 2010)."
    }
  ],
  "shuowen": "牛觸人，角箸橫木，所以告人也。从口从牛。《易》曰：“僮牛之告。”凡告之屬皆从告。",
