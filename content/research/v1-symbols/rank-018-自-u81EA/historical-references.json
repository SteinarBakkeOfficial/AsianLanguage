  "etymologyNotes": [
    {
      "s": "makemeahanzi",
      "t": "A nose; in China, people refer to themselves by pointing to their noses"
    },
    {
      "s": "dong_chinese",
      "t": "Pictograph of a nose. Original form of 鼻 (nose). In China, when people point to themselves, they typically point to their nose."
    },
    {
      "s": "shuowen_jiezi",
      "t": "鼻也。象鼻形。凡自之屬皆从自。",
      "w": 1
    },
    {
      "s": "wiktionary",
      "t": "Pictogram (象形): a nose — original form of 鼻 (OC *blids, “nose”). Later phonetically borrowed as an instance of jiajie (假借) for 自 (OC *ɦljids, “oneself; from”).\nFolk etymology considers the meaning to arise from a habit of pointing at one’s nose to indicate oneself."
    }
  ],
