  "etymologyNotes": [
    {
      "s": "makemeahanzi",
      "t": "A king 王 gazing at the moon 月; 亡 provides the pronunciation"
    },
    {
      "s": "dong_chinese",
      "t": "Pictograph of a person standing up (𡈼) and gazing at the moon (月). 亡 is a sound component that was added later."
    },
    {
      "s": "shuowen_jiezi",
      "t": "出亡在外，望其還也。从亾，朢省聲。",
      "w": 1
    },
    {
      "s": "wiktionary",
      "t": "Originally written 𦣠, an ideogrammic compound (會意 /会意): 臣 (“eye”) + 𡈼 (“person standing on the ground”) – a person standing up and looking off into the distance. Later 月 (“moon”) was added to produce 朢.\nThe 臣 component is now written 亡, making the current form a phono-semantic compound (形聲 /形声, OC *maŋ, *maŋs): phonetic 亡 (OC *maŋ) + semantic 月 + semantic 𡈼.\nFrom Proto-Sino-Tibetan *mV-taŋ (“to see”). Cognate with Burmese မြင် (mrang)."
    }
  ],
  "shuowen": "出亡在外，望其還也。从亾，朢省聲。",
  "shuowenExplanation": "出亡在外; 望其還. Composed of 亾 (semantic) with abbreviated 朢 as phonetic.",
