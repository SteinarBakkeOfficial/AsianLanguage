  "etymologyNotes": [
    {
      "s": "makemeahanzi",
      "t": "A herb 禾 with a sweet 甘 smell"
    },
    {
      "s": "dong_chinese",
      "t": "Represents the sweet (甘) smell of fresh grain (禾)."
    },
    {
      "s": "shuowen_jiezi",
      "t": "芳也。从黍从甘。《春秋傳》曰：“黍稷馨香。”凡香之屬皆从香。",
      "w": 1
    },
    {
      "s": "wiktionary",
      "t": "In the oracle bone script, it was ideogrammic compound (會意 /会意): 黍 (“glutinous millet”) + 口 (“mouth”). The whole character perhaps indicate that millet was used to produce liquor from fermentation which could be drank and/or sacrificed.\nIn the seal script, the 口 was replaced with the related 甘 (“sweet”). Hence, the most conservative variant is 𪏽.\nCurrently, the 黍 has simplified into 禾 and the form of the bottom component 甘 has become akin to the unrelated 曰."
    }
  ],
  "shuowen": "芳也。从黍从甘。《春秋傳》曰：“黍稷馨香。”凡香之屬皆从香。",
