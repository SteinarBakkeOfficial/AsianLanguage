  "etymologyNotes": [
    {
      "s": "makemeahanzi",
      "t": "A mother's breasts"
    },
    {
      "s": "dong_chinese",
      "t": "Pictograph of a woman kneeling, with two dots representing the two nipples that mothers use to feed their young."
    },
    {
      "s": "shuowen_jiezi",
      "t": "牧也。从女，象褱子形。一曰象乳子也。",
      "w": 1
    },
    {
      "s": "wiktionary",
      "t": "Differentiated form of 女 with the addition of distinguishing dots. In the early oracle bone texts both words 女 (OC *naʔ, *nas, “woman”) and 母 were written as 女 (Yao, 1989, Liu, 2011, Huang, 2014). Part of this character appears in 乳.\nFrom Proto-Sino-Tibetan *məʔ (“mother”)."
    }
  ],
  "shuowen": "牧也。从女，象褱子形。一曰象乳子也。",
  "shuowenExplanation": "To herd; to tend; a herdsman. Composed with 女; 象褱子形. Alternatively: 象乳子.",
