  "etymologyNotes": [
    {
      "s": "dong_chinese",
      "t": "Depicts a mouth (口) in a closed space (宀) making an echo sound. Based on the original meaning \"echo; sound\", now written as 響. The current meaning is a phonetic loan."
    },
    {
      "s": "shuowen_jiezi",
      "t": "北出牖也。从宀从口。《詩》曰：“塞向墐戶。”",
      "w": 1
    },
    {
      "s": "wiktionary",
      "t": "Ideogrammic compound (會意 /会意): 宀 (“house”) + 口 (“mouth”), echos in a place. The original form of 響 (OC *qʰaŋʔ). It was borrowed to represent 𠨍 (嚮) later. The mouth does not represent an opening as in 高 and 谷. Compare 冋.\n; “ACG: for (directed at, intended to belong to)”"
    }
  ],
  "shuowen": "北出牖也。从宀从口。《詩》曰：“塞向墐戶。”",
  "shuowenExplanation": "Toward. Composed of 宀 'roof' and 口 'mouth'. The Book of Odes says: \"塞向墐戶。\".",
