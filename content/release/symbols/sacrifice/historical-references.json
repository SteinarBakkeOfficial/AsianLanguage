  "etymologyNotes": [
    {
      "s": "makemeahanzi",
      "t": "Hand 寸 holding meat ⺼ over an altar 示"
    },
    {
      "s": "dong_chinese",
      "t": "Depicts a hand (又) offering meat (⺼) as a sacrifice to a deity (示)."
    },
    {
      "s": "shuowen_jiezi",
      "t": "祭祀也。从示，以手持肉。",
      "w": 1
    },
    {
      "s": "wiktionary",
      "t": "Ideogrammic compound (會意 /会意): 肉 (“meat”) + 又 (“hand”) + 示 (“altar, ceremony”) – the hand offers a piece of meat at the altar during a ceremony.\nThe 肉 is turned on its side and appears as 𱼀 in the regular script (compare 將, 然). The top right part is a form of 又.\nThe top is not related to but may be corrupted to 癶 in calligraphy and handwriting; this form also appeared in the second-round simplified list."
    }
  ],
