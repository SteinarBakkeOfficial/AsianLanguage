  "etymologyNotes": [
    {
      "s": "makemeahanzi",
      "t": "Three  parallel lines; compare 一 (one) and 二 (two)"
    },
    {
      "s": "dong_chinese",
      "t": "Three horizontal strokes, representing the number three."
    },
    {
      "s": "shuowen_jiezi",
      "t": "天地人之道也。从三數。凡三之屬皆从三。",
      "w": 1
    },
    {
      "s": "wiktionary",
      "t": "Ideogram (指事) - three parallel strokes. Compare with 一, one stroke meaning “one”, 二, two strokes meaning “two”, and 亖, four strokes meaning “four”.\nTriplication of 一 (“one”). See also 畺. Unrelated to 丰.\nFrom Proto-Sino-Tibetan *kV-sum.\nPronunciation in Early Middle Chinese should be *srim, but actually is *sam, with a non-retroflex initial consonant. This irregular development should be due by analogy with the initial of number four in EMC, *sijH."
    }
  ],
  "shuowen": "天地人之道也。从三數。凡三之屬皆从三。",
